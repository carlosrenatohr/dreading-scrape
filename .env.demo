# --- Cloudflare Worker (production) ---
# When INGEST_URL is set the scraper POSTs directly to the Worker's /api/ingest
# endpoint instead of writing to MongoDB/Redis. This is the recommended path.
# INGEST_URL="https://dreading-api-worker.<subdomain>.workers.dev/api/ingest"
# INGEST_TOKEN="<set via wrangler secret put or GitHub Actions secrets>"

# --- MongoDB (legacy, only when INGEST_URL is empty) ---
DB_URI="mongodb://mongo:27017"
DB_NAME="dailyreading"
DB_HOST=""
DB_USERNAME=""
DB_PASSWORD=""

# --- Redis (legacy, only when INGEST_URL is empty) ---
UPSTACK_ENDPOINT="redis"
UPSTACK_PORT=6379
UPSTACK_PASSWORD=
UPSTACK_SSL=false

# --- AI enrichment (legacy — only when writing to MongoDB directly) ---
# The Worker handles enrichment via Workers AI. This only matters when
# INGEST_URL is empty (legacy MongoDB path).
ENRICH_PROVIDER=stub
